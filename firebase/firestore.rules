rules_version = '2';
// Security rules for SANAD's Firestore structure (see src/models/firestore.ts and docs/firestore-data.md).
// Publish: Firebase console > Firestore Database > Rules, paste this file, Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isProvider() { return signedIn() && exists(/databases/$(database)/documents/providers/$(request.auth.uid)); }

    // Only the fields the app writes (see UserDoc, CarDoc, AddressDoc in src/models/firestore.ts).
    function onlyFields(fields) { return request.resource.data.keys().hasOnly(fields); }
    function validUser() {
      return onlyFields(['phone', 'name', 'createdAt', 'defaultCarId', 'defaultAddressId', 'firstWashUsed', 'pushToken'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
    }
    function validCar() {
      return onlyFields(['make', 'model', 'year', 'plate', 'color', 'fuel', 'isDefault', 'lastServiceAt'])
        && request.resource.data.plate is string && request.resource.data.isDefault is bool;
    }
    function validAddress() {
      return onlyFields(['label', 'line', 'landmark', 'location', 'isDefault'])
        && request.resource.data.location is latlng && request.resource.data.isDefault is bool;
    }

    // Customers own their profile, cars and addresses: nobody else can read or write them.
    match /users/{uid} {
      allow read, delete: if isUser(uid);
      // The profile's phone must be the number Firebase Authentication verified, and cannot change later.
      allow create: if isUser(uid) && validUser() && request.resource.data.phone == request.auth.token.phone_number;
      allow update: if isUser(uid) && validUser() && request.resource.data.phone == resource.data.phone;

      match /cars/{carId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && validCar();
      }
      match /addresses/{addressId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && validAddress();
      }
    }

    // Catalogue is public to signed-in users, edited only from the admin console.
    match /services/{serviceId} { allow read: if signedIn(); allow write: if false; }

    // Providers are readable by signed-in users. Profiles are added by an admin (scripts/add-provider.ts);
    // a provider can only switch themselves online or offline and share their location.
    match /providers/{providerId} {
      allow read: if signedIn();
      allow update: if isUser(providerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastLocation', 'geohash']);
    }

    // Orders: the customer creates and reads their own. Each open order is offered to the nearest
    // online provider only (offeredTo, V2 feature 8); that provider sees it, accepts it for themselves,
    // then moves it along one step at a time (V2 feature 4).
    match /orders/{orderId} {
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function isCustomer() { return signedIn() && resource.data.customerId == request.auth.uid; }
      function isAssigned() { return signedIn() && resource.data.providerId == request.auth.uid; }
      function isOpen() { return resource.data.dispatch == 'provider' && resource.data.providerId == null && resource.data.status == 'confirmed'; }
      function offeredToMe() { return resource.data.get('offeredTo', null) == request.auth.uid; }
      function nextStep(from, to) {
        return (from == 'accepted' && to == 'on_the_way') || (from == 'on_the_way' && to == 'arrived') || (from == 'arrived' && to == 'done');
      }

      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid
        && request.resource.data.providerId == null;
      allow read: if isCustomer() || isAssigned() || (isProvider() && resource.data.providerId == null && offeredToMe());
      allow update: if
        // The customer updates their own order but cannot assign or impersonate a technician. They may
        // offer it to the next technician only while no one has accepted it, and on an order sent to
        // technicians the only status they may set themselves is cancelled.
        (isCustomer() && !changed().hasAny(['customerId', 'providerId', 'provider', 'acceptedAt', 'dispatch'])
          && (!changed().hasAny(['offeredTo', 'offeredAt', 'offeredBefore']) || resource.data.providerId == null)
          && (resource.data.get('dispatch', 'simulated') != 'provider' || !changed().hasAny(['status']) || request.resource.data.status == 'cancelled'))
        // The provider the order is offered to accepts it, for themselves only. A second provider
        // accepting the same order is refused because providerId is no longer null.
        || (isProvider() && isOpen() && offeredToMe()
          && request.resource.data.providerId == request.auth.uid
          && request.resource.data.status == 'accepted'
          && changed().hasOnly(['providerId', 'provider', 'status', 'acceptedAt', 'statusHistory', 'updatedAt']))
        // The assigned provider moves the job one step: on the way, arrived, done.
        || (isAssigned() && nextStep(resource.data.status, request.resource.data.status)
          && changed().hasOnly(['status', 'statusHistory', 'updatedAt']));

      // Live location is written by the assigned provider and read by the customer.
      match /tracking/{doc} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
                                   || get(/databases/$(database)/documents/orders/$(orderId)).data.providerId == request.auth.uid);
        allow write: if signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.providerId == request.auth.uid;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
    }
  }
}
