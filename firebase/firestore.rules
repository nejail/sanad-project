rules_version = '2';
// Security rules for SANAD's Firestore structure (see src/models/firestore.ts and docs/firestore-data.md).
// Publish: Firebase console > Firestore Database > Rules, paste this file, Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isProvider() { return signedIn() && exists(/databases/$(database)/documents/providers/$(request.auth.uid)); }

    // Only the fields the app writes (see UserDoc, CarDoc, AddressDoc in src/models/firestore.ts).
    function onlyFields(fields) { return request.resource.data.keys().hasOnly(fields); }
    function validUser() {
      return onlyFields(['phone', 'name', 'createdAt', 'defaultCarId', 'defaultAddressId', 'firstWashUsed', 'pushToken'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
    }
    function validCar() {
      return onlyFields(['make', 'model', 'year', 'plate', 'color', 'fuel', 'isDefault', 'lastServiceAt'])
        && request.resource.data.plate is string && request.resource.data.isDefault is bool;
    }
    function validAddress() {
      return onlyFields(['label', 'line', 'landmark', 'location', 'isDefault'])
        && request.resource.data.location is latlng && request.resource.data.isDefault is bool;
    }

    // Customers own their profile, cars and addresses: nobody else can read or write them.
    match /users/{uid} {
      allow read, delete: if isUser(uid);
      // The profile's phone must be the number Firebase Authentication verified, and cannot change later.
      allow create: if isUser(uid) && validUser() && request.resource.data.phone == request.auth.token.phone_number;
      allow update: if isUser(uid) && validUser() && request.resource.data.phone == resource.data.phone;

      match /cars/{carId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && validCar();
      }
      match /addresses/{addressId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && validAddress();
      }
    }

    // Catalogue is public to signed-in users, edited only from the admin console.
    match /services/{serviceId} { allow read: if signedIn(); allow write: if false; }

    // Providers are readable by signed-in users; each provider edits only their own document.
    match /providers/{providerId} {
      allow read: if signedIn();
      allow update: if isUser(providerId);
    }

    // Orders: customer creates and reads their own; the assigned provider reads and updates status.
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow update: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);

      // Live location is written by the assigned provider and read by the customer.
      match /tracking/{doc} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
                                   || get(/databases/$(database)/documents/orders/$(orderId)).data.providerId == request.auth.uid);
        allow write: if signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.providerId == request.auth.uid;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
    }
  }
}
